{
  "name": "starlight-ai-label-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "pnpm --filter demo dev",
    "build": "pnpm --filter demo build",
    "preview": "pnpm --filter demo preview",
    "check": "pnpm --filter demo astro check",
    "check:pkg": "publint packages/starlight-ai-label",
    "test": "pnpm --filter starlight-ai-label test",
    "test:e2e": "playwright test",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --no-frozen-lockfile",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@playwright/test": "^1.63.0",
    "publint": "^0.3.24"
  }
}
