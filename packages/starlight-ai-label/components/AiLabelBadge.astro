---
import type { AiLabelScopeItem, AiLabelVariant } from '../schema';

interface Props {
  /** Which badge to render. */
  variant: AiLabelVariant;
  /** Short one-line summary of what was AI-touched. */
  note?: string;
  /** Override the default badge text (e.g. "AI Generated"). */
  label?: string;
  /** Detailed breakdown rendered as an expandable disclosure when the badge is clicked. */
  scope?: AiLabelScopeItem[];
}

const { variant, note, label, scope } = Astro.props;

const defaultLabels: Record<AiLabelVariant, string> = {
  basic: 'AI',
  generated: 'AI Generated',
  modified: 'AI Modified',
};

const resolvedLabel = label ?? defaultLabels[variant];
const hasScope = Boolean(scope && scope.length > 0);
---

<div class={`sl-ai-label sl-ai-label--${variant}`}>
  {
    hasScope ? (
      <details class="sl-ai-label__disclosure">
        <summary class="sl-ai-label__summary">
          <span class="sl-ai-label__pill">
            <svg class="sl-ai-label__icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 2c.4 3.6 1 5.6 2 7.5S16.9 12.6 20 13c-3.1.4-5.9 1.6-7 2.5S12 20.6 12 22c-.4-3.6-1-5.6-2-7.5S6.1 12.4 3 12c3.1-.4 5.9-1.6 7-2.5S12 3.4 12 2z"
              />
            </svg>
            <span>{resolvedLabel}</span>
            <svg
              class="sl-ai-label__chevron sl-ai-label__chevron--closed"
              viewBox="0 0 24 24"
              width="12"
              height="12"
              aria-hidden="true"
            >
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m6 9 6 6 6-6"
              />
            </svg>
            <svg
              class="sl-ai-label__chevron sl-ai-label__chevron--open"
              viewBox="0 0 24 24"
              width="12"
              height="12"
              aria-hidden="true"
            >
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m6 15 6-6 6 6"
              />
            </svg>
          </span>
        </summary>
        <div class="sl-ai-label__panel">
          <table class="sl-ai-label__scope">
            <tbody>
              {scope!.map((item) => (
                <tr>
                  <td>{item.aspect}</td>
                  <td>{item.detail}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    ) : (
      <span class="sl-ai-label__pill sl-ai-label__pill--static">
        <svg class="sl-ai-label__icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 2c.4 3.6 1 5.6 2 7.5S16.9 12.6 20 13c-3.1.4-5.9 1.6-7 2.5S12 20.6 12 22c-.4-3.6-1-5.6-2-7.5S6.1 12.4 3 12c3.1-.4 5.9-1.6 7-2.5S12 3.4 12 2z"
          />
        </svg>
        <span>{resolvedLabel}</span>
      </span>
    )
  }
  {note && <p class="sl-ai-label__note">{note}</p>}
</div>

<style>
  .sl-ai-label {
    /* Public theming API — override these to restyle the badge. */
    --sl-ai-label-bg: #111827;
    --sl-ai-label-color: #fff;
    --sl-ai-label-border-color: var(--sl-color-gray-5);
    --sl-ai-label-radius: 999px;
    --sl-ai-label-panel-bg: var(--sl-color-bg-nav);
    --sl-ai-label-panel-border-color: var(--sl-color-hairline);
    --sl-ai-label-muted-color: var(--sl-color-gray-3);
    margin: 0.75rem 0;
  }

  /* The pill's own border is only needed for definition against dark, near-black
     page backgrounds; a light page already gives it enough contrast on its own. */
  :root[data-theme='light'] .sl-ai-label {
    --sl-ai-label-border-color: transparent;
  }

  .sl-ai-label__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    background: var(--sl-ai-label-bg);
    color: var(--sl-ai-label-color);
    border: 1px solid var(--sl-ai-label-border-color);
    border-radius: var(--sl-ai-label-radius);
    padding: 0.3em 0.9em 0.3em 0.7em;
    font-family: var(--__sl-font, system-ui, sans-serif);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .sl-ai-label__pill--static {
    cursor: default;
  }

  .sl-ai-label__icon {
    flex-shrink: 0;
  }

  .sl-ai-label__summary {
    display: inline-block;
    cursor: pointer;
    list-style: none;
  }

  .sl-ai-label__summary::-webkit-details-marker {
    display: none;
  }

  .sl-ai-label__summary::marker {
    content: '';
    display: none;
  }

  .sl-ai-label__chevron {
    flex-shrink: 0;
  }

  .sl-ai-label__chevron--open {
    display: none;
  }

  .sl-ai-label__disclosure[open] .sl-ai-label__chevron--closed {
    display: none;
  }

  .sl-ai-label__disclosure[open] .sl-ai-label__chevron--open {
    display: block;
  }

  .sl-ai-label__panel {
    margin-top: 0.35rem;
    max-width: 32rem;
    overflow: hidden;
    border: 1px solid var(--sl-ai-label-panel-border-color);
    border-radius: 0.375rem;
  }

  .sl-ai-label__scope {
    width: 100%;
    border-collapse: collapse;
    background: var(--sl-ai-label-panel-bg);
  }

  .sl-ai-label__scope td {
    padding: 0.4rem 0.75rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    vertical-align: top;
    border: 1px solid var(--sl-ai-label-panel-border-color);
  }

  .sl-ai-label__scope td:first-child {
    font-weight: 600;
    white-space: nowrap;
  }

  .sl-ai-label__scope td:last-child {
    color: var(--sl-ai-label-muted-color);
  }

  .sl-ai-label__scope tr:first-child td {
    border-top: none;
  }

  .sl-ai-label__scope tr td:first-child {
    border-left: none;
  }

  .sl-ai-label__scope tr td:last-child {
    border-right: none;
  }

  .sl-ai-label__scope tr:last-child td {
    border-bottom: none;
  }

  .sl-ai-label__note {
    margin: 0.3rem 0 0;
    font-size: 0.8125rem;
    color: var(--sl-ai-label-muted-color);
  }
</style>
