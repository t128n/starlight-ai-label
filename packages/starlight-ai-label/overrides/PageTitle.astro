---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import AiLabelBadge from '../components/AiLabelBadge.astro';

const { entry } = Astro.locals.starlightRoute;
const { aiLabel } = entry.data;

const badgeProps = typeof aiLabel === 'string' ? { variant: aiLabel } : aiLabel;
---

<Default />
{badgeProps && <AiLabelBadge {...badgeProps} />}
